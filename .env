# === 数据采集 ===
# 逗号分隔的多个交易对（小写），由后台 Binance 组合流单连接采集
SYMBOLS=btcusdt,ethusdt
STREAMS=["depth@100ms","trade"]
IS_FUTURES=true

# Binance API 凭据（可选，预留未来私有数据流；公共数据无需）
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# === 存储 ===
SQLITE_PATH=./data/market.db
# 生产用 redis://host:port/db；本地测试可用 fake:// 走内存 fakeredis
REDIS_URL=fake://
REDIS_RETENTION_DAYS=7

# === 历史回填 ===
HISTORY_BACKFILL_DAYS=7
HISTORY_RETRY_CRON_HOUR=2

# === HTTP/WebSocket 服务 ===
API_HOST=0.0.0.0
API_PORT=8000
# 留空 = 不鉴权；非空时客户端需带 ?token=xxx
API_KEY=
WS_DEFAULT_HISTORY_MINUTES=60
WS_MAX_HISTORY_MINUTES=10080
WS_CLIENT_QUEUE_MAXSIZE=1000

# === 日志 ===
LOG_LEVEL=INFO
LOG_JSON=false
